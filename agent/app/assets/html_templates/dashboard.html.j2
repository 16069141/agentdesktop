{% extends "base.html.j2" %}
{% block content %}
<!-- Dashboard Header -->
<section class="hero" style="padding: 48px 0 40px;">
  <div class="container">
    {% if badge %}<span class="badge">{{ badge }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</section>

<!-- KPI Stats Row -->
{% for section in sections %}
{% if section.type == 'stats' %}
<section class="section" style="padding: 32px 0;">
  <div class="container">
    <div class="stats-row">
      {% for stat in section['items'] %}
      <div class="stat-item">
        <div class="stat-value">{{ stat.value }}</div>
        <div class="stat-label">{{ stat.label }}</div>
        {% if stat.trend %}
        <div class="tag tag-{{ 'success' if stat.trend|float > 0 else 'danger' }}">
          {{ '+' ~ stat.trend ~ '%' if stat.trend|float > 0 else stat.trend ~ '%' }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endfor %}

<!-- Charts Grid -->
<section class="section section-alt" style="padding: 40px 0;">
  <div class="container">
    <div class="grid-2">
      {% set chart_idx = namespace(val=0) %}
      {% for section in sections %}
      {% if section.type == 'chart' %}
      {% set chart_idx.val = chart_idx.val + 1 %}
      <div class="chart-container">
        {% if section.chart_title %}<h4>{{ section.chart_title }}</h4>{% endif %}
        <div class="chart-canvas-wrap">
          <canvas id="{{ section.id }}"></canvas>
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Data Table -->
{% for section in sections %}
{% if section.type == 'table' %}
<section class="section" style="padding: 40px 0;">
  <div class="container">
    {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
    <div class="table-wrap">
      <table>
        {% if section.headers %}
        <thead><tr>
          {% for h in section.headers %}<th>{{ h }}</th>{% endfor %}
        </tr></thead>
        {% endif %}
        <tbody>
          {% for row in section.rows %}
          <tr>
            {% for cell in row %}<td>{{ cell }}</td>{% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}
{% endfor %}

<!-- Summary / Cards -->
{% for section in sections %}
{% if section.type == 'cards' %}
<section class="section section-alt" style="padding: 40px 0;">
  <div class="container">
    {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
    <div class="card-grid cols-{{ section.cols | default(4) }}">
      {% for card in section['items'] %}
      <div class="card">
        {% if card.icon %}<div class="card-icon">{{ card.icon }}</div>{% endif %}
        <h3>{{ card.title }}</h3>
        <p>{{ card.content }}</p>
        {% if card.metric %}
        <div class="card-metric">{{ card.metric }}</div>
        <div class="card-label">{{ card.label }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endfor %}

<!-- Text sections -->
{% for section in sections %}
{% if section.type in ['heading', 'paragraph', 'list', 'quote'] %}
<section class="section" style="padding: 40px 0;">
  <div class="container-narrow">
    {% if section.type == 'heading' %}
      <h{{ section.level | default(2) }}>{{ section.title }}</h{{ section.level | default(2) }}>
      {% if section.content %}<p>{{ section.content }}</p>{% endif %}
    {% elif section.type == 'paragraph' %}
      <p>{{ section.content }}</p>
    {% elif section.type == 'quote' %}
      <blockquote>{{ section.content }}</blockquote>
    {% elif section.type == 'list' %}
      {% if section.title %}<h3>{{ section.title }}</h3>{% endif %}
      <ul class="feature-list">
        {% for item in section['items'] %}<li>{{ item }}</li>{% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% endif %}
{% endfor %}

<footer>
  <div class="container">
    <p>{{ footer_text | default('Dashboard generated by AI Assistant') }}</p>
  </div>
</footer>
{% endblock %}

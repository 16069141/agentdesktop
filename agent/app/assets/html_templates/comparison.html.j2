{% extends "base.html.j2" %}
{% block content %}
<!-- Hero -->
<section class="hero">
  <div class="container">
    {% if badge %}<span class="badge">{{ badge }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</section>

<!-- Comparison sections -->
{% for section in sections %}
<section class="section{% if section.alt_bg %} section-alt{% endif %}">
  <div class="container">
    {% if section.type == 'heading' %}
      <h{{ section.level | default(2) }}>{{ section.title }}</h{{ section.level | default(2) }}>
      {% if section.content %}<p>{{ section.content }}</p>{% endif %}

    {% elif section.type == 'paragraph' %}
      <p>{{ section.content }}</p>

    {% elif section.type == 'table' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="table-wrap compare-table">
        <table>
          {% if section.headers %}
          <thead><tr>
            {% for h in section.headers %}
            <th>{{ h }}</th>
            {% endfor %}
          </tr></thead>
          {% endif %}
          <tbody>
            {% for row in section.rows %}
            <tr>
              {% for cell in row %}
              <td>
                {% if cell == true or cell == 'yes' or cell == 'Yes' %}
                  <span class="check-icon">&#10003;</span>
                {% elif cell == false or cell == 'no' or cell == 'No' %}
                  <span class="cross-icon">&#10007;</span>
                {% else %}
                  {{ cell }}
                {% endif %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    {% elif section.type == 'cards' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="card-grid cols-{{ section.cols | default(2) }}">
        {% for card in section['items'] %}
        <div class="card{% if card.highlight %} col-highlight{% endif %}">
          {% if card.tag %}<span class="tag tag-primary mb-2">{{ card.tag }}</span>{% endif %}
          <h3>{{ card.title }}</h3>
          <p>{{ card.content }}</p>
          {% if card.features %}
          <ul class="feature-list mt-2">
            {% for f in card.features %}<li>{{ f }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% if card.price %}
          <div class="card-metric mt-2">{{ card.price }}</div>
          <div class="card-label">{{ card.price_label | default('') }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>

    {% elif section.type == 'chart' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="chart-container">
        {% if section.chart_title %}<h4>{{ section.chart_title }}</h4>{% endif %}
        <div class="chart-canvas-wrap">
          <canvas id="{{ section.id }}"></canvas>
        </div>
      </div>

    {% elif section.type == 'grid-2' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="grid-2">
        <div>
          {% if section.left_title %}<h3>{{ section.left_title }}</h3>{% endif %}
          {% if section.left_html %}{{ section.left_html | safe }}{% endif %}
          {% if section.left_items %}
          <ul class="feature-list">
            {% for item in section.left_items %}<li>{{ item }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        <div>
          {% if section.right_title %}<h3>{{ section.right_title }}</h3>{% endif %}
          {% if section.right_html %}{{ section.right_html | safe }}{% endif %}
          {% if section.right_items %}
          <ul class="feature-list">
            {% for item in section.right_items %}<li>{{ item }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>

    {% elif section.type == 'list' %}
      {% if section.title %}<h3>{{ section.title }}</h3>{% endif %}
      <ul class="feature-list">
        {% for item in section['items'] %}<li>{{ item }}</li>{% endfor %}
      </ul>

    {% elif section.type == 'cta' %}
      <div class="cta">
        <h2>{{ section.title }}</h2>
        {% if section.content %}<p class="text-muted mb-4">{{ section.content }}</p>{% endif %}
        <a href="{{ section.link | default('#') }}" class="cta-btn">{{ section.button_text | default('开始使用') }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% endfor %}

<footer>
  <div class="container">
    <p>{{ footer_text | default('Comparison generated by AI Assistant') }}</p>
  </div>
</footer>
{% endblock %}

{% extends "base.html.j2" %}
{% block content %}
<!-- Hero -->
<section class="hero">
  <div class="container">
    {% if badge %}<span class="badge">{{ badge }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    {% if meta %}
    <div style="margin-top: 1.5em; font-size: 0.85rem; opacity: 0.7;">
      {{ meta }}
    </div>
    {% endif %}
  </div>
</section>

<!-- Body sections -->
{% for section in sections %}
<section class="section{% if section.alt_bg %} section-alt{% endif %}">
  <div class="{{ 'container-narrow' if section.narrow else 'container' }}">
    {% if section.type == 'heading' %}
      <h{{ section.level | default(2) }}>{{ section.title }}</h{{ section.level | default(2) }}>
      {% if section.content %}<p>{{ section.content }}</p>{% endif %}

    {% elif section.type == 'paragraph' %}
      <p>{{ section.content }}</p>

    {% elif section.type == 'cards' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="card-grid cols-{{ section.cols | default(3) }}">
        {% for card in section['items'] %}
        <div class="card">
          {% if card.icon %}<div class="card-icon">{{ card.icon }}</div>{% endif %}
          <h3>{{ card.title }}</h3>
          <p>{{ card.content }}</p>
          {% if card.metric %}
          <div class="card-metric">{{ card.metric }}</div>
          <div class="card-label">{{ card.label }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>

    {% elif section.type == 'table' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="table-wrap">
        <table>
          {% if section.headers %}
          <thead><tr>
            {% for h in section.headers %}<th>{{ h }}</th>{% endfor %}
          </tr></thead>
          {% endif %}
          <tbody>
            {% for row in section.rows %}
            <tr>
              {% for cell in row %}<td>{{ cell }}</td>{% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    {% elif section.type == 'chart' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="chart-container">
        {% if section.chart_title %}<h4>{{ section.chart_title }}</h4>{% endif %}
        <div class="chart-canvas-wrap">
          <canvas id="{{ section.id }}"></canvas>
        </div>
      </div>

    {% elif section.type == 'stats' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="stats-row">
        {% for stat in section['items'] %}
        <div class="stat-item">
          <div class="stat-value">{{ stat.value }}</div>
          <div class="stat-label">{{ stat.label }}</div>
        </div>
        {% endfor %}
      </div>

    {% elif section.type == 'quote' %}
      <blockquote>{{ section.content }}</blockquote>

    {% elif section.type == 'list' %}
      {% if section.title %}<h3>{{ section.title }}</h3>{% endif %}
      <ul class="feature-list">
        {% for item in section['items'] %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>

    {% elif section.type == 'timeline' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="timeline">
        {% for item in section['items'] %}
        <div class="timeline-item">
          <h4>{{ item.title }}</h4>
          {% if item.time %}<span class="time">{{ item.time }}</span>{% endif %}
          <p>{{ item.content }}</p>
        </div>
        {% endfor %}
      </div>

    {% elif section.type == 'grid-2' %}
      {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
      <div class="grid-2">
        <div>{{ section.left_html | safe }}</div>
        <div>{{ section.right_html | safe }}</div>
      </div>

    {% elif section.type == 'cta' %}
      <div class="cta">
        <h2>{{ section.title }}</h2>
        {% if section.content %}<p class="text-muted mb-4">{{ section.content }}</p>{% endif %}
        <a href="{{ section.link | default('#') }}" class="cta-btn">{{ section.button_text | default('了解更多') }}</a>
        {% if section.secondary_text %}
        <a href="{{ section.secondary_link | default('#') }}" class="cta-btn secondary">{{ section.secondary_text }}</a>
        {% endif %}
      </div>

    {% endif %}
  </div>
</section>
{% endfor %}

<!-- Footer -->
<footer>
  <div class="container">
    <p>{{ footer_text | default('Generated by AI Assistant') }}</p>
  </div>
</footer>
{% endblock %}
